# FedX-Palm FL Server - CPU-only (VPS demo)
# ~2 GB image vs ~7 GB CUDA variant. Same fed_server.py code.
FROM python:3.10-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    DEBIAN_FRONTEND=noninteractive \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1-mesa-glx libglib2.0-0 libsm6 libxext6 libxrender1 \
    gcc python3-dev curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install CPU-only torch (much smaller than CUDA build)
RUN pip install --upgrade pip && \
    pip install --index-url https://download.pytorch.org/whl/cpu \
        torch==2.1.0 torchvision==0.16.0 && \
    pip install \
        ultralytics==8.3.40 \
        flwr==1.9.0 \
        numpy==1.26.4 \
        pyyaml==6.0.1 \
        opencv-python-headless==4.10.0.84

COPY server/ /app/server/
COPY utils/ /app/utils/
COPY models/ /app/models/

RUN mkdir -p /app/checkpoints /app/logs

EXPOSE 8080

ENTRYPOINT ["python", "-m", "server.fed_server"]
CMD ["--address", "0.0.0.0:8080", "--num-rounds", "1", "--num-classes", "6", "--min-clients", "2"]
